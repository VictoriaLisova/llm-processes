                        "position": "executive producer"
                    },
                    {
                        "name": "The Neighbourhood",
                        "position": "executive producer"
                    }
                ],
                "reviews": [
                    {
                        "publicationName": "Exclaim!",
                        "critic": {
                            "name": "Ryan B. Patrick",
                            "position": "writer"
                        },
                        "summary": "a \"see what sticks\" effort; it's slick and polished, but hits varying levels of satisfaction throughout."
                    },
                    {
                        "publicationName": "DIY",
                        "critic": {
                            "name": "Natasha West",
                            "position": "writer"
                        },
                        "summary": "Wiped Out! delivers a message of heartbreak, hope and heartfelt honesty"
                    },
                    {
                        "publicationName": "Mojo Magazine",
                        "critic": null,
                        "summary": "The LA quintet still sound like 16-year-old boys... Musically, though, their slick soulful pop-R&B is far more refined"
                    },
                    {
                        "publicationName": "AllMusic",
                        "critic": {
                            "name": "Matt Collar",
                            "position": "writer"
                        },
                        "summary": "doesn't hurt that cuts like \"Cry Baby,\" \"Daddy Issues,\" and \"Greetings from Califournia\" counteract the band's somewhat downtempo vibe with catchy melodies and light, dance-oriented beats."
                    },
                    {
                        "publicationName": "Billboard",
                        "critic": {
                            "name": "Kenneth Partridge",
                            "position": "writer"
                        },
                        "summary": "The subtler, less stylized Wiped Out! keeps the palm-trees-at-twilight feel, but the sound is more hazy R&B than rock"
                    },
                    {
                        "publicationName": "Rolling Stone",
                        "critic": {
                            "name": "David Turner",
                            "position": "writer"
                        },
                        "summary": "the warmth of \"Sweater Weather\" and the rest of the Neighbourhood's debut album is gone on Wiped Out!, replaced by a ponderous kind of cool"
                    },
                    {
                        "publicationName": "Uncut",
                        "critic": null,
                        "summary": "a stylistic and conceptual vacuum."
                    }
                ]
            }
        ],
