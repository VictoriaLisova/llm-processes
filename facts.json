    {
        "name": "The Neighbourhood",
        "yearCreated": 2013,
        "albums": [
            {
                "name": "I Love You",
                "label": "null",
                "releaseDate": "April 22, 2013",
                "songs": [
                    {
                        "name": "How"
                    },
                    {
                        "name": "Afraid"
                    },
                    {
                        "name": "Everybody`s Watching Me (Uh Oh)"
                    },
                    {
                        "name": "Sweater Weather"
                    },
                    {
                        "name": "Let It Go"
                    },
                    {
                        "name": "Alleyways"
                    },
                    {
                        "name": "W.D.Y.W.F.M?"
                    },
                    {
                        "name": "Flawless"
                    },
                    {
                        "name": "Female Robbery"
                    },
                    {
                        "name": "Staying Up"
                    },
                    {
                        "name": "Float"
                    }
                ],
                "producers": [
                    {
                        "name": "Justyn Pilbrow",
                        "position": "production"
                    },
                    {
                        "name": "Emile Haynie",
                        "position": "production"
                    }
                ],
                "reviews": [
                    {
                        "publicationName": "Los Angeles Times",
                        "critic": {
                            "name": "Mikael Wood",
                            "position": "critic"
                        },
                        "summary": "Their songs mostly stretch out into dreary electro-goth atmospherics and lack any kind of urgency"
                    },
                    {
                        "publicationName": "AllMusic",
                        "critic": {
                            "name": "Tim Sendra",
                            "position": "editor"
                        },
                        "summary": "The album's music rarely deviates from its ponderous nature, ultimately leaving the listener with an overall experience that is oppressively grey and joyless"
                    },
                    {
                        "publicationName": "Drowned in Sound",
                        "critic": {
                            "name": "Kat Rolle",
                            "position": "critic"
                        },
                        "summary": "Lyrics are inane and thematically limited to California and sex, while panning the band's musical approach as unoriginal and calculated for mass appeal"
                    },
                    {
                        "publicationName": "DIY",
                        "critic": {
                            "name": "Jamie Milton",
                            "position": "critic"
                        },
                        "summary": "The Neighbourhood stick to the remarkably fully formed mantra they arrived on the scene chanting, achieving what few debuts can, by making one hell of an opening statement"
                    },
                    {
                        "publicationName": "The Guardian",
                        "critic": {
                            "name": "Caroline Sullivan",
                            "position": "critic"
                        },
                        "summary": "Critical of the album's petulant lyrics, which were obviously aimed at teenagers, but concluded that its dreamy melancholy and high-shine production and traditional songcraft may nonetheless appeal to a broader audience"
                    },
                    {
                        "publicationName": "Irish Times",
                        "critic": {
                            "name": "Jim Carroll",
                            "position": "critic"
                        },
                        "summary": "The band's hooky pop songs can be ravishing, but the album is weighed down by occasional fillers"
                    }
                ]
            }
        ],
